<Window x:Class="JoystickX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JoystickX - Xbox Controller Emulator" Height="760" Width="1180"
        MinHeight="650" MinWidth="900" Background="#111318" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#191C22"/><SolidColorBrush x:Key="Green" Color="#42B883"/><SolidColorBrush x:Key="Border" Color="#30343D"/><SolidColorBrush x:Key="Muted" Color="#9DA4B1"/>
        <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#252932"/><Setter Property="BorderBrush" Value="#3A4050"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#BFC5D0"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#171A20" Height="66" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0">
                <TextBlock Text="●" Foreground="#42B883" FontSize="24" VerticalAlignment="Center"/>
                <TextBlock Text="JoystickX" FontSize="21" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Virtual Xbox Controller Emulator" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="Made by Sanjay" Foreground="{StaticResource Green}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#171A20" Height="30" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <TextBlock Text="Made by Sanjay" Foreground="{StaticResource Muted}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <GroupBox Header="Devices"><StackPanel><ComboBox x:Name="DeviceCombo" DisplayMemberPath="DisplayName" SelectionChanged="DeviceCombo_SelectionChanged" Margin="4"/><TextBlock x:Name="DeviceStatus" Margin="5" Foreground="{StaticResource Muted}" Text="No controller selected"/><UniformGrid Columns="2"><Button Content="Refresh Devices" Click="Refresh_Click"/><Button Content="Connect Device" Click="Connect_Click"/></UniformGrid></StackPanel></GroupBox>
                <GroupBox Header="Virtual Controller"><StackPanel><TextBlock x:Name="DriverStatus" Foreground="#F1A54A" Margin="5" Text="Checking ViGEmBus driver..."/><TextBlock x:Name="VirtualStatus" Margin="5" Foreground="{StaticResource Muted}" Text="Virtual controller disconnected"/><TextBlock x:Name="EmulationStatus" Margin="5" Text="Emulation stopped"/><UniformGrid Columns="2"><Button x:Name="StartButton" Content="Start Emulation" Click="Start_Click"/><Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False"/></UniformGrid><Button Content="Open ViGEmBus Downloads" Click="OpenDriver_Click"/><TextBlock Text="Requires administrator installation. No driver is bundled or silently disabled." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="5"/></StackPanel></GroupBox>
                <GroupBox Header="Profile"><DockPanel><ComboBox x:Name="ProfileCombo" Width="150"/><Button DockPanel.Dock="Right" Content="Save" Click="SaveProfile_Click"/><Button DockPanel.Dock="Right" Content="Load" Click="LoadProfile_Click"/><TextBox x:Name="ProfileName" Text="Default" Margin="4"/></DockPanel></GroupBox>
            </StackPanel>
            <TabControl Grid.Column="1" Background="#111318" BorderBrush="{StaticResource Border}">
                <TabItem Header="Input Monitor"><ScrollViewer><StackPanel Margin="10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <GroupBox Header="Analog Sticks"><StackPanel><TextBlock x:Name="LeftStickText"/><ProgressBar x:Name="LX" Height="8" Minimum="-32768" Maximum="32767"/><ProgressBar x:Name="LY" Height="8" Minimum="-32768" Maximum="32767"/><TextBlock x:Name="RightStickText" Margin="0,8,0,0"/><ProgressBar x:Name="RX" Height="8" Minimum="-32768" Maximum="32767"/><ProgressBar x:Name="RY" Height="8" Minimum="-32768" Maximum="32767"/></StackPanel></GroupBox>
                        <GroupBox Header="Triggers" Grid.Column="1"><StackPanel><TextBlock x:Name="LTText"/><ProgressBar x:Name="LT" Height="10" Maximum="255"/><TextBlock x:Name="RTText"/><ProgressBar x:Name="RT" Height="10" Maximum="255"/></StackPanel></GroupBox>
                    </Grid>
                    <GroupBox Header="Buttons"><WrapPanel x:Name="ButtonPanel"/></GroupBox>
                    <GroupBox Header="D-pad"><TextBlock x:Name="DpadText" FontSize="16" Margin="5" Text="Centered"/></GroupBox>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="Mappings">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <WrapPanel Grid.Row="0" Grid.ColumnSpan="2">
                            <Button Content="Reset to Default" Click="ResetMapping_Click"/>
                            <TextBlock Text="Map to:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                            <ComboBox x:Name="MapTargetCombo" Width="150" Margin="0,4" SelectedIndex="0">
                                <ComboBoxItem Content="A"/>
                                <ComboBoxItem Content="B"/>
                                <ComboBoxItem Content="X"/>
                                <ComboBoxItem Content="Y"/>
                                <ComboBoxItem Content="LeftShoulder"/>
                                <ComboBoxItem Content="RightShoulder"/>
                                <ComboBoxItem Content="Back"/>
                                <ComboBoxItem Content="Start"/>
                                <ComboBoxItem Content="LeftThumb"/>
                                <ComboBoxItem Content="RightThumb"/>
                                <ComboBoxItem Content="LeftTrigger"/>
                                <ComboBoxItem Content="RightTrigger"/>
                                <ComboBoxItem Content="DpadUp"/>
                                <ComboBoxItem Content="DpadDown"/>
                                <ComboBoxItem Content="DpadLeft"/>
                                <ComboBoxItem Content="DpadRight"/>
                            </ComboBox>
                                                            <Button Content="Detect Physical Button" Click="DetectButton_Click"/>
                                <Button Content="Guided Setup" Click="StartGuidedMapping_Click" Foreground="#42B883" FontWeight="Bold"/>
                        </WrapPanel>
                        <Border Grid.Row="1" Grid.Column="0" Background="#191C22" BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="4">
                            <Viewbox Stretch="Uniform" Margin="12">
                                <Canvas Width="430" Height="250">
                                    <Path Fill="#30343D" Stroke="#8A919D" StrokeThickness="2" Data="M112,55 C82,55 52,72 40,110 C24,158 18,214 48,232 C78,248 102,198 122,176 L308,176 C328,198 352,248 382,232 C412,214 406,158 390,110 C378,72 348,55 318,55 L112,55 Z"/>
                                    <Rectangle Canvas.Left="153" Canvas.Top="58" Width="124" Height="70" RadiusX="18" RadiusY="18"
                                               Fill="#101318" Stroke="#707887" StrokeThickness="2"/>
                                    <Rectangle Canvas.Left="160" Canvas.Top="65" Width="110" Height="56" RadiusX="12" RadiusY="12"
                                               Fill="#161A20" Opacity="0.95"/>
                                    <Ellipse Canvas.Left="205" Canvas.Top="84" Width="20" Height="20" Fill="#252A32" Stroke="#606776"/>
                                    <Ellipse x:Name="LeftThumbVisual" Tag="LeftThumb" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="115" Canvas.Top="102" Width="52" Height="52" Fill="#20242B" Stroke="#8A919D" StrokeThickness="2"/>
                                    <Ellipse x:Name="RightThumbVisual" Tag="RightThumb" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="263" Canvas.Top="112" Width="52" Height="52" Fill="#20242B" Stroke="#8A919D" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="62" Canvas.Top="70" Width="42" Height="42" Fill="#20242B" Stroke="#8A919D" StrokeThickness="2"/>
                                    <Path Canvas.Left="75" Canvas.Top="80" Data="M0,-9 L6,0 L0,9 L-6,0 Z" Fill="#BFC5D0"/>
                                    <Ellipse x:Name="AButtonVisual" Tag="A" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="336" Canvas.Top="153" Width="30" Height="30" Fill="#42A5F5"/>
                                    <Ellipse x:Name="BButtonVisual" Tag="B" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="370" Canvas.Top="119" Width="30" Height="30" Fill="#EF5350"/>
                                    <Ellipse x:Name="XButtonVisual" Tag="X" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="302" Canvas.Top="119" Width="30" Height="30" Fill="#42A5F5"/>
                                    <Ellipse x:Name="YButtonVisual" Tag="Y" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="336" Canvas.Top="85" Width="30" Height="30" Fill="#FFCA28"/>
                                    <TextBlock Text="A" Canvas.Left="347" Canvas.Top="158" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="B" Canvas.Left="381" Canvas.Top="124" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="X" Canvas.Left="313" Canvas.Top="124" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="Y" Canvas.Left="347" Canvas.Top="90" Foreground="White" FontWeight="Bold"/>
                                    <Ellipse x:Name="LBVisual" Tag="LeftShoulder" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="101" Canvas.Top="38" Width="78" Height="26" Fill="#4A505D"/>
                                    <Ellipse x:Name="RBVisual" Tag="RightShoulder" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="251" Canvas.Top="38" Width="78" Height="26" Fill="#4A505D"/>
                                    <Ellipse x:Name="LTVisual" Tag="LeftTrigger" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="112" Canvas.Top="18" Width="38" Height="18" Fill="#4A505D"/>
                                    <Ellipse x:Name="RTVisual" Tag="RightTrigger" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="280" Canvas.Top="18" Width="38" Height="18" Fill="#4A505D"/>
                                    <TextBlock Text="LT" Canvas.Left="120" Canvas.Top="1" Foreground="#BFC5D0" FontWeight="Bold"/>
                                    <TextBlock Text="RT" Canvas.Left="288" Canvas.Top="1" Foreground="#BFC5D0" FontWeight="Bold"/>
                                    <Ellipse x:Name="DpadUpVisual" Tag="DpadUp" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="83" Canvas.Top="72" Width="18" Height="18" Fill="#20242B" Stroke="#8A919D"/>
                                    <Ellipse x:Name="DpadDownVisual" Tag="DpadDown" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="83" Canvas.Top="108" Width="18" Height="18" Fill="#20242B" Stroke="#8A919D"/>
                                    <Ellipse x:Name="DpadLeftVisual" Tag="DpadLeft" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="65" Canvas.Top="90" Width="18" Height="18" Fill="#20242B" Stroke="#8A919D"/>
                                    <Ellipse x:Name="DpadRightVisual" Tag="DpadRight" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="101" Canvas.Top="90" Width="18" Height="18" Fill="#20242B" Stroke="#8A919D"/>
                                    <TextBlock Text="LB" Canvas.Left="123" Canvas.Top="42" Foreground="White" FontSize="11"/>
                                    <TextBlock Text="RB" Canvas.Left="273" Canvas.Top="42" Foreground="White" FontSize="11"/>
                                    <TextBlock Text="LS" Canvas.Left="132" Canvas.Top="119" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="RS" Canvas.Left="280" Canvas.Top="129" Foreground="White" FontWeight="Bold"/>
                                    <Ellipse x:Name="BackVisual" Tag="Back" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="181" Canvas.Top="91" Width="28" Height="20" Fill="#4A505D"/>
                                    <Ellipse x:Name="StartVisual" Tag="Start" MouseLeftButtonUp="MappingButton_Click" Cursor="Hand" Canvas.Left="221" Canvas.Top="91" Width="28" Height="20" Fill="#4A505D"/>
                                    <TextBlock Text="View" Canvas.Left="181" Canvas.Top="116" Foreground="#BFC5D0" FontSize="10"/>
                                    <TextBlock Text="Menu" Canvas.Left="220" Canvas.Top="116" Foreground="#BFC5D0" FontSize="10"/>
                                    <TextBlock x:Name="AMapLabel" Text="A: -" Canvas.Left="320" Canvas.Top="190" Foreground="#BFC5D0" FontSize="11"/>
                                    <TextBlock x:Name="BMapLabel" Text="B: -" Canvas.Left="355" Canvas.Top="190" Foreground="#BFC5D0" FontSize="11"/>
                                    <TextBlock x:Name="XMapLabel" Text="X: -" Canvas.Left="320" Canvas.Top="205" Foreground="#BFC5D0" FontSize="11"/>
                                    <TextBlock x:Name="YMapLabel" Text="Y: -" Canvas.Left="355" Canvas.Top="205" Foreground="#BFC5D0" FontSize="11"/>
                                    <TextBlock x:Name="LBMapLabel" Text="LB: -" Canvas.Left="96" Canvas.Top="20" Foreground="#BFC5D0" FontSize="10"/>
                                    <TextBlock x:Name="RBMapLabel" Text="RB: -" Canvas.Left="251" Canvas.Top="20" Foreground="#BFC5D0" FontSize="10"/>
                                    <TextBlock x:Name="BackMapLabel" Text="View: -" Canvas.Left="167" Canvas.Top="65" Foreground="#BFC5D0" FontSize="10"/>
                                    <TextBlock x:Name="StartMapLabel" Text="Menu: -" Canvas.Left="211" Canvas.Top="65" Foreground="#BFC5D0" FontSize="10"/>
                                    <TextBlock x:Name="LSMapLabel" Text="LS: -" Canvas.Left="115" Canvas.Top="162" Foreground="#BFC5D0" FontSize="10"/>
                                    <TextBlock x:Name="RSMapLabel" Text="RS: -" Canvas.Left="264" Canvas.Top="172" Foreground="#BFC5D0" FontSize="10"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <DataGrid x:Name="MappingGrid" Grid.Row="1" Grid.Column="1" AutoGenerateColumns="False" Background="#191C22" Foreground="Black" Margin="4">
                            <DataGrid.Columns><DataGridTextColumn Header="Physical Input" Binding="{Binding PhysicalInput}" Width="*"/><DataGridTextColumn Header="Virtual Xbox Output" Binding="{Binding VirtualOutput}" Width="*"/></DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="GuidedMappingOverlay"
                                Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Visibility="Collapsed" Background="#EE111318" Panel.ZIndex="100">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                                    <TextBlock Text="Gamepad Calibration" FontSize="34" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,0,0,18"/>
                                    <TextBlock x:Name="GuidedProgress" Text="1/16" FontSize="16"
                                               Foreground="#BFC5D0" HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="GuidedProgressBar" Height="10" Minimum="1" Maximum="16" Value="1"
                                                 Foreground="#42B883" Background="#30343D" BorderThickness="0"
                                                 Margin="0,16,0,26"/>
                                    <TextBlock x:Name="GuidedPrompt" Text="Press the A equivalent on your gamepad."
                                               FontSize="20" HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="GuidedStatus" Text="Keep the button pressed briefly, then release it."
                                               FontSize="13" Foreground="#BFC5D0" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,22"/>
                                    <Button Content="Cancel Calibration" Click="CancelGuidedMapping_Click"
                                            Width="180" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Settings"><StackPanel Margin="8"><TextBlock Text="Stick Deadzone"/><Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="0.35" Value="0.08" ValueChanged="DeadzoneSlider_ValueChanged"/><TextBlock Text="Trigger Deadzone"/><Slider x:Name="TriggerSlider" Minimum="0" Maximum="0.35" Value="0.04"/><TextBlock Text="Sensitivity"/><Slider x:Name="SensitivitySlider" Minimum="0.5" Maximum="1.5" Value="1"/><CheckBox x:Name="InvertLeftY" Content="Invert left stick Y" Margin="0,10,0,0" Foreground="White"/><CheckBox x:Name="InvertRightY" Content="Invert right stick Y" Foreground="White"/><TextBlock Text="USB device hiding: optional HidHide integration is not enabled by default. Install HidHide separately, add JoystickX as an allowed application, hide only after confirming JoystickX can read the device, and reverse it in HidHide Configuration Client." TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{StaticResource Muted}"/></StackPanel></TabItem>
                <TabItem Header="Help"><ScrollViewer><StackPanel Margin="12"><TextBlock Text="Setup" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. Connect the physical USB controller.&#x0a;2. Select it and press Connect Device.&#x0a;3. Install signed ViGEmBus through the official download link and reboot if prompted.&#x0a;4. Start emulation.&#x0a;5. Verify Xbox 360 Controller for Windows appears in Win+R joy.cpl." TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="RDR2 Testing" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Launch RDR2 after emulation starts. If Steam input is enabled, open Controller Settings and disable conflicting physical-device layouts. Use the official Rockstar or Steam launcher and test through the game's Controller settings." TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="Safety" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Stop emulation before closing JoystickX. JoystickX does not modify driver signatures, disable Windows security, or bundle driver binaries." TextWrapping="Wrap" Margin="0,8"/></StackPanel></ScrollViewer></TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
